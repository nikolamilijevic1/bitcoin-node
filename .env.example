# Copy to .env to customize ports, credentials, or regtest dataset settings.

# Shared Grafana admin password (apply before first startup)
GRAFANA_PASSWORD=regtest-dashboard

# Regtest (compose.yml)
DATASET_SIZE=medium
DATASET_SEED=2026
EXPLORER_PORT=8090
GUIDE_PORT=8091
GRAFANA_PORT=3001

# Testnet4 (compose.testnet4.yml)
T4_EXPLORER_PORT=8092
T4_GUIDE_PORT=8093
T4_GRAFANA_PORT=3002

# Mainnet (compose.mainnet.yml)
MAINNET_EXPLORER_PORT=8094
MAINNET_GUIDE_PORT=8095
MAINNET_GRAFANA_PORT=3003
MAINNET_RPC_USER=bitcoin
MAINNET_RPC_PASSWORD=change-me-mainnet-rpc
MAINNET_DB_PASSWORD=change-me-mainnet-db
MAINNET_DB_ROOT_PASSWORD=change-me-mainnet-root
